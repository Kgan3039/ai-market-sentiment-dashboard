    "near_cohesion_floor_margin": 0.05,
    "other_coverage_policy": "explicit_entry_per_story_with_stated_reason; never a narrative theme",
    "other_coverage_reasons": "below_clustering_floor,below_cohesion_floor,below_theme_size_floor,clustering_noise,degenerate_embedding_geometry,insufficient_theme_structure,provider_quarantine,semantic_skip,theme_incompatible",
    "outlet_count_policy": "upstream ThemeStory.outlet_count is authoritative when present; len(outlets) is a fallback, never a substitute",
    "outlier_policy": "clustering_noise_to_other_coverage_never_dropped",
    "permutation_selection_policy": "reverse_then_interleave_never_random",
    "perturbation_selection_policy": "drop_the_least_recent_story",
    "quarantine_policy": "upstream_quarantined_and_semantically_skipped_stories_held_out_of _clustering_and_shown_under_other_coverage",
    "ranking_policy": "salience = weighted(story_count, outlet_diversity, recency)",
    "recency_half_life_hours": 6.0,
