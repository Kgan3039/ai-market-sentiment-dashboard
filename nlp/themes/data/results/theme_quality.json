    "summarization_adapter.published_at": "isoformat_utc",
    "summarization_adapter.rejects": "other_coverage, excluded, unknown story keys, duplicates",
    "summarization_adapter.story_id": "theme_evidence.story_key_verbatim",
    "summarization_adapter.version": "m5.summarization_adapter.v1",
