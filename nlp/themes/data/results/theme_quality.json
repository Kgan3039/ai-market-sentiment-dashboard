    "compatibility.family.decision.negative": "ban,banned,bans,block,blocked,blocks,denied,denies,deny,lose,loses,lost,overturn,overturned,overturns,refuse,refused,refuses,reject,rejected,rejects",
    "compatibility.family.decision.positive": "approval,approve,approved,approves,authorise,authorises,authorize,authorized,authorizes,clear,cleared,clears,grant,granted,grants,upheld,uphold,upholds,win,wins,won",
    "compatibility.family.direction.negative": "cut,cuts,decline,declined,declines,downgrade,downgraded,downgrades,drop,dropped,drops,fall,falls,fell,lower,lowered,lowers,reduce,reduced,reduces,shrank,shrink,shrinks,slash,slashed,slashes,slow,slowed,slows,trim,trimmed,trims,weaker",
    "compatibility.family.direction.positive": "add,added,adds,boost,boosted,boosts,climb,climbed,climbs,expand,expanded,expands,grew,grow,grows,higher,increase,increased,increases,jump,jumped,jumps,lift,lifted,lifts,raise,raised,raises,rise,rises,rose,stronger,upgrade,upgraded,upgrades",
    "compatibility.family.performance.negative": "lag,lagged,lags,miss,missed,misses,trail,trailed,trails,underperform,underperforms",
    "compatibility.family.performance.positive": "beat,beats,exceed,exceeded,exceeds,outperform,outperforms,top,topped,tops",
    "compatibility.mixed_family_rule": "takes_no_side_and_conflicts_with_nothing",
    "compatibility.negation_markers": "cannot,denied,denies,fail,failed,fails,never,no,nor,not,wont",
    "compatibility.negation_rule": "odd_parity_of_preceding_markers_in_the_same_clause",
    "compatibility.negation_window": "4",
    "compatibility.non_negating_bigrams": "not only",
    "compatibility.permitted_differences": "reporting_period,named_entities,named_roles,article_type,quantities_and_units,repeated_distinct_events",
    "compatibility.scope": "whole_prospective_theme",
    "compatibility.text_scope": "title_and_description",
    "compatibility.tie_break": "majority_then_leading_story",
    "compatibility.tokenizer": "nlp.dedup.structural.tokenize",
    "compatibility.version": "m5.compatibility.v2",
    "degenerate_geometry_epsilon": 0.0,
    "degenerate_geometry_policy": "no_separable_structure_produces_no_theme; every story goes to other coverage with a stated reason; meets_ac4_shape reports false rather than inventing a split to satisfy the band",
    "description_selection_policy": "first_non_empty_description_in_member_id_order; not canonical provenance, because M3 publishes no canonical raw member",
    "embedding_dimension": 384,
    "exclusion_reasons": "no_encodable_text",
    "fallback.band_applies_to": "surviving_theme_count_not_dendrogram_cut",
    "fallback.candidate_band": "min_themes..min(n-1, max_themes*cap_factor)",
    "fallback.candidate_cap_factor": "2",
    "fallback.coverage_rank": "5_of_6_never_outranks_coherence",
    "fallback.label_numbering": "renumbered_by_first_appearance",
    "fallback.linkage": "average",
    "fallback.metric": "precomputed_cosine_distance",
    "fallback.no_valid_partition": "no_separable_structure_no_theme_invented",
    "fallback.objective": "max_stories_in_themes_clearing_size_and_cohesion_floors",
    "fallback.objective_order": "1_mandatory_floors, 2_most_coherent_themes_in_band, 3_max_min_pairwise, 4_max_mean_cohesion, 5_max_coverage, 6_min_k",
    "fallback.subset_extraction": "shed_least_central_until_both_floors_or_give_up",
    "fallback.tie_break": "higher_mean_cohesion, fewer_themes, smaller_k",
    "fallback.trigger": "cluster_count_outside_band_or_a_cluster_below_cohesion_floor",
    "label_genericity_policy": "representative = member title scored by distinct informative tokens, entity and numeral evidence, and repetition penalty; then outlet_count, recency, story_key. Verbatim member title only; never synthesized",
    "label_policy": "leading_member_title; deterministic; no model call; label never participates in membership identity",
